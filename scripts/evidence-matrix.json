{
  "$schema": "measix-evidence-matrix-v1",
  "description": "Machine-readable evidence mapping matrix: links each capability requirement to its test artifact, test names, test layer, source file, and category. This file is the canonical mapping consumed by freeze-manifest.mjs and CI gates.",
  "layers": {
    "T0": "Unit test — single function, no external dependencies",
    "T1": "Component test — multiple internal packages, in-process",
    "T2": "Integration test — real DB (SQLite), real HTTP relay, no network",
    "T3": "System test — real adapter/client, full stack in-process",
    "T4.1": "E2E browser test — Playwright, real browser, full stack"
  },
  "categories": {
    "CONTRACT": "OpenAPI/wire/schema validation",
    "CAPABILITY": "Capability definition and validation",
    "UPSTREAM": "Upstream provider management",
    "PUBLISH": "Runtime control publish pipeline",
    "RELAY": "Relay forwarding, auth, routing",
    "METERING": "Usage metering and spool",
    "SECURITY": "Security: auth, CSRF, secrets, topology",
    "RESILIENCE": "Crash recovery, reconciliation, idempotency",
    "CONCURRENCY": "Concurrent access and race conditions",
    "GATE": "Freeze gate and manifest"
  },
  "artifacts": {
    "backend-test.json": {"type": "go-test-json", "description": "Backend unit/component/integration tests (go test -json)", "layers": ["T0", "T1", "T2"]},
    "system-test.json": {"type": "go-test-json", "description": "Backend system tests with real adapter/client", "layers": ["T3"]},
    "console-test.json": {"type": "vitest-json", "description": "Admin console unit/component tests (Vitest)", "layers": ["T0", "T1"]},
    "candidate-test.json": {"type": "go-test-json", "description": "Candidate gate tests — full backend integration scenarios", "layers": ["T2", "T3"]},
    "e2e-playwright.json": {"type": "playwright-json", "description": "Browser E2E tests (Playwright)", "layers": ["T4.1"]},
    "static-contract.json": {"type": "static-analysis", "description": "Static contract drift check (OpenAPI vs generated code)", "layers": ["T0"]},
    "resource-baseline.json": {"type": "runtime-metrics", "description": "Resource baseline metrics (RSS, CPU, TTFB)", "layers": ["T3"]},
    "real-adapter-qualification.json": {"type": "adapter-qualification", "description": "Real adapter qualification evidence", "layers": ["T3"]}
  },
