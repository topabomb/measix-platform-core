diff --git a/backend/internal/hub/httpapi/pagination.go b/backend/internal/hub/httpapi/pagination.go
new file mode 100644
index 0000000..687eb80
--- /dev/null
+++ b/backend/internal/hub/httpapi/pagination.go
@@ -0,0 +1,27 @@
+package httpapi
+
+import (
+	"encoding/base64"
+	"errors"
+)
+
+var errInvalidCursor = errors.New("invalid cursor")
+
+func decodeCursor(cursor *string) (string, error) {
+	if cursor == nil || *cursor == "" {
+		return "", nil
+	}
+	decoded, err := base64.RawURLEncoding.DecodeString(*cursor)
+	if err != nil || len(decoded) == 0 {
+		return "", errInvalidCursor
+	}
+	return string(decoded), nil
+}
+
+func encodeCursor(value string) *string {
+	if value == "" {
+		return nil
+	}
+	cursor := base64.RawURLEncoding.EncodeToString([]byte(value))
+	return &cursor
+}
diff --git a/backend/internal/hub/upstream/list_test.go b/backend/internal/hub/upstream/list_test.go
new file mode 100644
index 0000000..479bdc9
--- /dev/null
+++ b/backend/internal/hub/upstream/list_test.go
@@ -0,0 +1,59 @@
+package upstream_test
+
+import (
+	"context"
+	"sort"
+	"testing"
+	"time"
+
+	"measix/platform/internal/hub/testutil"
+	"measix/platform/internal/hub/upstream"
+	"measix/platform/internal/wire/adminapi"
+)
+
+func TestListUpstreamsUsesStableCursorPagination(t *testing.T) {
+	ctx := context.Background()
+	st := testutil.OpenStoreHandle(t)
+	now := time.Date(2026, 8, 19, 19, 0, 0, 0, time.UTC)
+	identity := testutil.NewIdentityService(t, st, now)
+	boot, err := identity.Bootstrap(ctx, "Example Corp", "admin", "Admin", "correct horse battery staple")
+	if err != nil {
+		t.Fatal(err)
+	}
+	service := upstream.NewService(st.Client, nil)
+	service.Now = func() time.Time { return now }
+
+	var want []string
+	for _, name := range []string{"A", "B", "C"} {
+		view, err := service.CreateUpstream(ctx, boot.AdminUserID, adminapi.UpstreamConfig{
+			Name: name, BaseUrl: "https://adapter.example", TransportCapabilities: []string{"HTTP_REQUEST_RESPONSE"},
+			Auth:            adminapi.UpstreamConfig_Auth{Type: adminapi.NONE, AdditionalProperties: map[string]interface{}{}},
+			CorrelationMode: "NONE", UsageCapabilityLevel: adminapi.LEVEL0,
+			TimeoutDefaults: adminapi.TimeoutPolicy{ConnectMs: 1000, ResponseHeaderMs: 5000, IdleMs: 30000},
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		want = append(want, view.UpstreamID)
+	}
+	sort.Strings(want)
+
+	first, cursor, err := service.ListUpstreams(ctx, 2, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(first) != 2 || cursor == "" {
+		t.Fatalf("first page len=%d cursor=%q, want 2 and non-empty", len(first), cursor)
+	}
+	if first[0].UpstreamID != want[0] || first[1].UpstreamID != want[1] || cursor != want[1] {
+		t.Fatalf("first page=%v cursor=%q want=%v", []string{first[0].UpstreamID, first[1].UpstreamID}, cursor, want[:2])
+	}
+
+	second, next, err := service.ListUpstreams(ctx, 2, cursor)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(second) != 1 || second[0].UpstreamID != want[2] || next != "" {
+		t.Fatalf("second page len=%d id=%v next=%q", len(second), second[0].UpstreamID, next)
+	}
+}
