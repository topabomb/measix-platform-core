# ============================================================================
# Real Adapter Qualification Configuration
# ============================================================================
# This file is gitignored and will NEVER be committed to the repository.
#
# Usage:
#   1. cp .env.adapter-qualification.example .env.adapter-qualification
#   2. Fill in your endpoint details below
#   3. Run: node scripts/collect-adapter-qualification.mjs --dotenv
#
# SECURITY: The script reads this file at runtime. API keys are stored ONLY
# in Hub's Secret store at runtime. They are NEVER written to any .artifacts/
# file or console output.
#
# Architecture note:
#   Each profile (MODEL/TTS/ASR/MCP) has its own independent configuration.
#   This reflects the real-world scenario where different capabilities may
#   be served by different adapters/endpoints with different credentials.
#   If all profiles share the same endpoint, simply repeat the same values.
# ============================================================================

# ----------------------------------------------------------------------------
# MODEL profile (OPENAI_CHAT_COMPLETIONS) — REQUIRED
# This is the chat completion endpoint, e.g. /v1/chat/completions
# ----------------------------------------------------------------------------
MODEL_ENDPOINT=https://api.example.com
MODEL_API_KEY=sk-your-model-api-key
MODEL_ID=gpt-4o-mini

# ----------------------------------------------------------------------------
# TTS profile (OPENAI_AUDIO_SPEECH) — OPTIONAL
# Leave empty to skip. If your endpoint supports /v1/audio/speech, fill in.
# ----------------------------------------------------------------------------
TTS_ENDPOINT=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=alloy

# ----------------------------------------------------------------------------
# ASR profile (OPENAI_AUDIO_TRANSCRIPTIONS) — OPTIONAL
# Leave empty to skip. If your endpoint supports /v1/audio/transcriptions.
# ----------------------------------------------------------------------------
ASR_ENDPOINT=
ASR_API_KEY=
ASR_MODEL=

# ----------------------------------------------------------------------------
# MCP profile (MCP_STREAMABLE_HTTP) — OPTIONAL
# Leave empty to skip. If you have an MCP Streamable HTTP server endpoint.
# ----------------------------------------------------------------------------
MCP_ENDPOINT=
MCP_API_KEY=

# ----------------------------------------------------------------------------
# Admin password for auto-started Hub (optional, defaults to 'admin')
# Must be 12-128 Unicode code points.
# ----------------------------------------------------------------------------
# MEASIX_ADMIN_PASSWORD=qual-admin-pass-2026
