# ============================================================================
# measix-platform-core .gitignore
# 覆盖 Go 后端、Node 前端、OpenAPI 生成链、Atlas 迁移和编辑器/OS 杂项
# ============================================================================

# ----------------------------------------------------------------------------
# Go
# ----------------------------------------------------------------------------
/backend/backend
/backend/*.exe
/backend/*.exe~
/backend/*.test
/backend/*.out
/backend/coverage.out
/backend/coverage.html
/backend/profile.out
/backend/debug
/backend/__debug_bin*
# Coverage / race 输出
*.cover
# Go workspace 文件（如本地用 go work 编排多模块，按需取消注释）
# /go.work
# /go.work.sum

# 依赖目录（Go modules）
# go.sum 由 go mod tidy 维护，需提交；不忽略

# ----------------------------------------------------------------------------
# Node / pnpm（console 子项目）
# ----------------------------------------------------------------------------
/console/node_modules/
/node_modules/
# pnpm store（若使用本地 store）
/.pnpm-store/
# 构建产物
/console/dist/
/console/.quasar/
/console/.vscode/
# 生成器输出的运行时副本（保留 committed 副本，忽略运行时重新生成副本）
/console/src/api/generated.ts.bak
# Volar / Vue 类型缓存
/console/.vite/
# Playwright test results and reports (local, not committed)
/console/test-results/
/console/playwright-report/
# 日志
/console/npm-debug.log*
/console/pnpm-debug.log*
/console/.pnpm-debug.log*
# 本地环境变量
/console/.env.local
/console/.env.*.local

# ----------------------------------------------------------------------------
# 根级 monorepo 编排（未来扩展）
# ----------------------------------------------------------------------------
/.vscode/
/.idea/
*.log
.DS_Store
Thumbs.db

# ----------------------------------------------------------------------------
# OpenAPI / 生成链运行时缓存
# ----------------------------------------------------------------------------
# 生成代码本身（admin.gen.go、generated.ts）作为契约漂移护栏提交，不忽略；
# 仅忽略工具运行时缓存
/.openapi-cache/
/.codegen-tmp/

# ----------------------------------------------------------------------------
# Atlas 运行时产物
# ----------------------------------------------------------------------------
# atlas.sum 和 migration SQL 是不可变审计产物，必须提交；
# 仅忽略本地测试库和 atlas 运行时目录
/backend/migrations/.atlas/
*.db-journal
*.db-wal
*.db-shm

# ----------------------------------------------------------------------------
# 本地开发数据库与密钥
# ----------------------------------------------------------------------------
/.secrets/
/.data/
/backend/.data/
/backend/.secrets/
*.local.db
*.local.sqlite
*.local.key
*.local.pem
/backend/cmd/devserver/.secrets/

# ----------------------------------------------------------------------------
# CI / CodeBuddy 运行时
# ----------------------------------------------------------------------------
/.codebuddy/run/
/.codebuddy/tmp/
# 团队协作邮箱/历史由平台托管，但本地运行时缓存忽略

# ----------------------------------------------------------------------------
# Test result artifacts (generated by collect-artifacts, consumed by freeze-manifest)
# ----------------------------------------------------------------------------
/.artifacts/

# ----------------------------------------------------------------------------
# Temporary scripts / data files (local debugging, not committed)
# ----------------------------------------------------------------------------
/scripts/_*.mjs
/scripts/_*.txt
/scripts/_*.json
