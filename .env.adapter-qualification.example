# ============================================================================
# Real Adapter Qualification Configuration
# ============================================================================
# Copy this file to .env.adapter-qualification and fill in your real endpoint
# details. The .env.adapter-qualification file is gitignored and will NEVER
# be committed to the repository.
#
# Usage:
#   1. cp .env.adapter-qualification.example .env.adapter-qualification
#   2. Fill in your endpoint details below
#   3. Run: node scripts/collect-adapter-qualification.mjs --dotenv
#
# SECURITY: Never commit .env.adapter-qualification. The script reads it
# at runtime and does NOT write the API key into any artifact file.
# ============================================================================

# Your OpenAI-compatible endpoint base URL (without /v1 suffix)
# Example: https://api.openai.com
ADAPTER_ENDPOINT=https://api.example.com

# Your API key for the endpoint
# This is used as a Bearer token and is stored ONLY in Hub's Secret store
# at runtime. It is never written to any .artifacts/ file.
ADAPTER_API_KEY=sk-your-api-key-here

# Chat model ID for OPENAI_CHAT_COMPLETIONS profile
# This is the model identifier your endpoint expects in the "model" field
# Example: gpt-4o-mini, deepseek-chat, etc.
ADAPTER_MODEL_ID=gpt-4o-mini

# --- Optional: TTS configuration ---
# If your endpoint supports /v1/audio/speech, set the model and voice.
# Leave empty if TTS is not supported — the profile will be marked NOT_EXECUTED.
ADAPTER_TTS_MODEL=
ADAPTER_TTS_VOICE=alloy

# --- Optional: ASR configuration ---
# If your endpoint supports /v1/audio/transcriptions, set the model.
# Leave empty if ASR is not supported — the profile will be marked NOT_EXECUTED.
ADAPTER_ASR_MODEL=

# --- Optional: MCP configuration ---
# If you have an MCP Streamable HTTP server endpoint, fill in:
# Leave empty if MCP is not supported — the profile will be marked NOT_EXECUTED.
ADAPTER_MCP_ENDPOINT=
ADAPTER_MCP_API_KEY=

# --- Optional: Admin password for auto-started Hub ---
# If you let the script start its own Hub+Relay, this is the admin password.
# If not set, defaults to 'admin'.
# MEASIX_ADMIN_PASSWORD=admin
