{
  "name": "measix-admin-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "quasar dev",
    "prepare": "quasar prepare",
    "generate:api": "openapi-typescript ../api/admin/admin.openapi.yaml -o src/api/generated.ts",
    "typecheck": "quasar prepare && tsc --noEmit",
    "test": "vitest run",
    "build": "quasar build"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "pinia": "4.0.2",
    "quasar": "2.23.3",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "3.7.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "2.4.6",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "4.1.0"
  }
}
